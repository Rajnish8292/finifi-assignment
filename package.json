{
  "name": "three-way-match-engine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:next\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:next": "next dev -p 3000",
    "build": "npm run build:server && npm run build:next",
    "build:server": "tsc -p tsconfig.server.json",
    "build:next": "next build",
    "start": "concurrently \"npm run start:server\" \"npm run start:next\"",
    "start:server": "node dist-server/index.js",
    "start:next": "next start -p 3000",
    "seed": "tsx server/src/seed.ts",
    "test": "tsx server/src/test/runner.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@tanstack/react-query": "^5.67.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.12.0",
    "multer": "^1.4.5-lts.1",
    "next": "^15.1.7",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
